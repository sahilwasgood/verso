<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Tag/lyrics/artwork writes into the user's own music files need this
         on API 30+. Requested once via system Settings (never silently);
         justified in README/F-Droid metadata. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <package android:name="com.maxmpz.audioplayer" />
    </queries>

    <application
        android:name=".LyricTagApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LyricTag">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.maxmpz.audioplayer.ACTION_LYRICS_LINK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".poweramp.LyricsRequestReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.maxmpz.audioplayer.ACTION_NEED_LYRICS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".poweramp.PlaybackReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.maxmpz.audioplayer.TRACK_CHANGED_EXPLICIT" />
                <action android:name="com.maxmpz.audioplayer.STATUS_CHANGED_EXPLICIT" />
            </intent-filter>
        </receiver>

        <!-- MediaSession fallback for scrobbling on builds that don't emit
             track broadcasts (verified on Poweramp trial build-1025).
             User-granted via system notification-access Settings. -->
        <service
            android:name=".scrobble.PlaybackListenerService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
